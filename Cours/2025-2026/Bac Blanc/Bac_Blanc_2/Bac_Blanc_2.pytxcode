def f(n):
  return f"{10.0/(2.0+15.0*n):.3f}"

L = [1,10,50,100,150,200,500]
fL = list(map(f,L))
print(r"\begin{tblr}{hlines,vlines, columns = {mode=dmath}}")
print(r"n &" + " & ".join(list(map(str,L))) + r"\\")
print(r"u_n \simeq &" + " & ".join(list(map(str,fL))) + r"\\")
print(r"\end{tblr}")
